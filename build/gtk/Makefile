	cd "/home/uriy/Рабочий стол/SvinLaucnher/build" && $(MAKE) $(MAKESILENT) -f gtk/CMakeFiles/svinlauncher.dir/build.make gtk/CMakeFiles/svinlauncher.dir/ui/install_progress.cpp.s
.PHONY : ui/install_progress.cpp.s

