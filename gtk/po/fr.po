msgid ""
msgstr ""
"Project-Id-Version: SvinLauncher 1.0\n"
"Language: fr\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Не удалось сохранить язык интерфейса"
msgstr "Impossible d’enregistrer la langue de l’interface"
msgid "Язык сохранён. Перезапустите SvinLauncher, чтобы применить его."
msgstr "Langue enregistrée. Redémarrez SvinLauncher pour l’appliquer."
msgid "Настройки SvinLauncher"
msgstr "Paramètres de SvinLauncher"
msgid "Закрыть"
msgstr "Fermer"
msgid "Сохранить"
msgstr "Enregistrer"
msgid "Минимальный лаунчер Minecraft Java Edition для GNOME. Создавайте экземпляры, выбирайте офлайн-имя и запускайте игру."
msgstr "Un lanceur Minecraft Java Edition minimal pour GNOME. Créez des instances, choisissez un pseudo hors ligne et jouez."
msgid "Язык интерфейса"
msgstr "Langue de l’interface"
msgid "Язык системы"
msgstr "Langue du système"
msgid "Создать экземпляр"
msgstr "Créer une instance"
msgid "Обновить список"
msgstr "Actualiser la liste"
msgid "Настройки лаунчера"
msgstr "Paramètres du lanceur"
msgid "Нет экземпляров"
msgstr "Aucune instance"
msgid "Создайте vanilla экземпляр, чтобы начать играть."
msgstr "Créez une instance vanilla pour commencer à jouer."
msgid "Имя игрока (оффлайн)"
msgstr "Nom du joueur (hors ligne)"
msgid "Играть"
msgstr "Jouer"
msgid "Экземпляр с таким именем уже существует"
msgstr "Une instance portant ce nom existe déjà"
msgid "Minecraft установлен, экземпляр готов к офлайн-запуску"
msgstr "Minecraft est installé. L’instance est prête pour jouer hors ligne."
msgid "Не удалось установить Minecraft"
msgstr "Impossible d’installer Minecraft"
msgid "Укажите название и версию вида 1.21.1"
msgstr "Indiquez un nom et une version comme 1.21.1"
msgid "Не удалось загрузить список версий"
msgstr "Impossible de charger la liste des versions"
msgid "Новый экземпляр"
msgstr "Nouvelle instance"
msgid "Создайте чистый экземпляр Minecraft Java Edition."
msgstr "Créez une instance vierge de Minecraft Java Edition."
msgid "Отмена"
msgstr "Annuler"
msgid "Создать"
msgstr "Créer"
msgid "Загружаю список версий…"
msgstr "Chargement de la liste des versions…"
msgid "Название"
msgstr "Nom"
msgid "Версия Minecraft, например 1.21.1 (можно ввести вручную)"
msgstr "Version de Minecraft, par exemple 1.21.1 (saisie manuelle possible)"
msgid "Дополнительные действия"
msgstr "Autres actions"
msgid "Открыть папку"
msgstr "Ouvrir le dossier"
msgid "Удалить"
msgstr "Supprimer"
msgid "Сначала закройте запущенную игру"
msgstr "Fermez d’abord le jeu en cours"
msgid "Экземпляр не найден или его путь некорректен"
msgstr "Instance introuvable ou chemin incorrect"
msgid "Не удалось полностью удалить файлы экземпляра"
msgstr "Impossible de supprimer tous les fichiers de l’instance"
msgid "Экземпляр удалён"
msgstr "Instance supprimée"
msgid "Файлы экземпляра и ярлыки будут удалены без возможности восстановления."
msgstr "Les fichiers et raccourcis de l’instance seront supprimés définitivement."
msgid "Удалить экземпляр «%s»?"
msgstr "Supprimer l’instance « %s » ?"
msgid "Ник должен содержать от 1 до 16 латинских букв, цифр или знаков _"
msgstr "Le pseudo doit contenir de 1 à 16 lettres latines, chiffres ou tirets bas (_)"
msgid "Установка Minecraft"
msgstr "Installation de Minecraft"
msgid "Подготовка установки…"
msgstr "Préparation de l’installation…"
msgid "Загрузка игрового клиента"
msgstr "Téléchargement du client du jeu"
msgid "Игровой клиент загружен"
msgstr "Client du jeu téléchargé"
msgid "Загрузка библиотек"
msgstr "Téléchargement des bibliothèques"
msgid "Распаковка библиотек"
msgstr "Extraction des bibliothèques"
msgid "Загрузка игровых ресурсов"
msgstr "Téléchargement des ressources du jeu"
msgid "Завершение установки"
msgstr "Finalisation de l’installation"
msgid "Осталось"
msgstr "Restant"
msgid "Файлов: "
msgstr "Fichiers : "
msgid "файлов"
msgstr "fichiers"
