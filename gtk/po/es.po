msgid ""
msgstr ""
"Project-Id-Version: SvinLauncher 1.0\n"
"Language: es\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Не удалось сохранить язык интерфейса"
msgstr "No se pudo guardar el idioma de la interfaz"
msgid "Язык сохранён. Перезапустите SvinLauncher, чтобы применить его."
msgstr "Idioma guardado. Reinicia SvinLauncher para aplicarlo."
msgid "Настройки SvinLauncher"
msgstr "Ajustes de SvinLauncher"
msgid "Закрыть"
msgstr "Cerrar"
msgid "Сохранить"
msgstr "Guardar"
msgid "Минимальный лаунчер Minecraft Java Edition для GNOME. Создавайте экземпляры, выбирайте офлайн-имя и запускайте игру."
msgstr "Un lanzador minimalista de Minecraft Java Edition para GNOME. Crea instancias, elige un nombre sin conexión y juega."
msgid "Язык интерфейса"
msgstr "Idioma de la interfaz"
msgid "Язык системы"
msgstr "Idioma del sistema"
msgid "Создать экземпляр"
msgstr "Crear instancia"
msgid "Обновить список"
msgstr "Actualizar lista"
msgid "Настройки лаунчера"
msgstr "Ajustes del lanzador"
msgid "Нет экземпляров"
msgstr "No hay instancias"
msgid "Создайте vanilla экземпляр, чтобы начать играть."
msgstr "Crea una instancia vanilla para empezar a jugar."
msgid "Имя игрока (оффлайн)"
msgstr "Nombre del jugador (sin conexión)"
msgid "Играть"
msgstr "Jugar"
msgid "Экземпляр с таким именем уже существует"
msgstr "Ya existe una instancia con este nombre"
msgid "Minecraft установлен, экземпляр готов к офлайн-запуску"
msgstr "Minecraft está instalado. La instancia está lista para jugar sin conexión."
msgid "Не удалось установить Minecraft"
msgstr "No se pudo instalar Minecraft"
msgid "Укажите название и версию вида 1.21.1"
msgstr "Introduce un nombre y una versión como 1.21.1"
msgid "Не удалось загрузить список версий"
msgstr "No se pudo cargar la lista de versiones"
msgid "Новый экземпляр"
msgstr "Nueva instancia"
msgid "Создайте чистый экземпляр Minecraft Java Edition."
msgstr "Crea una instancia limpia de Minecraft Java Edition."
msgid "Отмена"
msgstr "Cancelar"
msgid "Создать"
msgstr "Crear"
msgid "Загружаю список версий…"
msgstr "Cargando lista de versiones…"
msgid "Название"
msgstr "Nombre"
msgid "Версия Minecraft, например 1.21.1 (можно ввести вручную)"
msgstr "Versión de Minecraft, por ejemplo 1.21.1 (también puedes escribirla)"
msgid "Дополнительные действия"
msgstr "Más acciones"
msgid "Открыть папку"
msgstr "Abrir carpeta"
msgid "Удалить"
msgstr "Eliminar"
msgid "Сначала закройте запущенную игру"
msgstr "Cierra primero el juego en ejecución"
msgid "Экземпляр не найден или его путь некорректен"
msgstr "No se encontró la instancia o la ruta no es válida"
msgid "Не удалось полностью удалить файлы экземпляра"
msgstr "No se pudieron eliminar todos los archivos de la instancia"
msgid "Экземпляр удалён"
msgstr "Instancia eliminada"
msgid "Файлы экземпляра и ярлыки будут удалены без возможности восстановления."
msgstr "Los archivos y accesos directos de la instancia se eliminarán permanentemente."
msgid "Удалить экземпляр «%s»?"
msgstr "¿Eliminar la instancia «%s»?"
msgid "Ник должен содержать от 1 до 16 латинских букв, цифр или знаков _"
msgstr "El nombre debe tener entre 1 y 16 letras latinas, números o guiones bajos (_)"
msgid "Установка Minecraft"
msgstr "Instalando Minecraft"
msgid "Подготовка установки…"
msgstr "Preparando la instalación…"
msgid "Загрузка игрового клиента"
msgstr "Descargando el cliente del juego"
msgid "Игровой клиент загружен"
msgstr "Cliente del juego descargado"
msgid "Загрузка библиотек"
msgstr "Descargando bibliotecas"
msgid "Распаковка библиотек"
msgstr "Extrayendo bibliotecas"
msgid "Загрузка игровых ресурсов"
msgstr "Descargando recursos del juego"
msgid "Завершение установки"
msgstr "Finalizando la instalación"
msgid "Осталось"
msgstr "Queda"
msgid "Файлов: "
msgstr "Archivos: "
msgid "файлов"
msgstr "archivos"
