msgid ""
msgstr ""
"Project-Id-Version: SvinLauncher 1.0\n"
"Language: pt_BR\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Не удалось сохранить язык интерфейса"
msgstr "Não foi possível salvar o idioma da interface"
msgid "Язык сохранён. Перезапустите SvinLauncher, чтобы применить его."
msgstr "Idioma salvo. Reinicie o SvinLauncher para aplicá-lo."
msgid "Настройки SvinLauncher"
msgstr "Configurações do SvinLauncher"
msgid "Закрыть"
msgstr "Fechar"
msgid "Сохранить"
msgstr "Salvar"
msgid "Минимальный лаунчер Minecraft Java Edition для GNOME. Создавайте экземпляры, выбирайте офлайн-имя и запускайте игру."
msgstr "Um launcher minimalista de Minecraft Java Edition para o GNOME. Crie instâncias, escolha um nome offline e jogue."
msgid "Язык интерфейса"
msgstr "Idioma da interface"
msgid "Язык системы"
msgstr "Idioma do sistema"
msgid "Создать экземпляр"
msgstr "Criar instância"
msgid "Обновить список"
msgstr "Atualizar lista"
msgid "Настройки лаунчера"
msgstr "Configurações do launcher"
msgid "Нет экземпляров"
msgstr "Nenhuma instância"
msgid "Создайте vanilla экземпляр, чтобы начать играть."
msgstr "Crie uma instância vanilla para começar a jogar."
msgid "Имя игрока (оффлайн)"
msgstr "Nome do jogador (offline)"
msgid "Играть"
msgstr "Jogar"
msgid "Экземпляр с таким именем уже существует"
msgstr "Já existe uma instância com esse nome"
msgid "Minecraft установлен, экземпляр готов к офлайн-запуску"
msgstr "Minecraft instalado. A instância está pronta para jogar offline."
msgid "Не удалось установить Minecraft"
msgstr "Não foi possível instalar o Minecraft"
msgid "Укажите название и версию вида 1.21.1"
msgstr "Informe um nome e uma versão, como 1.21.1"
msgid "Не удалось загрузить список версий"
msgstr "Não foi possível carregar a lista de versões"
msgid "Новый экземпляр"
msgstr "Nova instância"
msgid "Создайте чистый экземпляр Minecraft Java Edition."
msgstr "Crie uma instância limpa do Minecraft Java Edition."
msgid "Отмена"
msgstr "Cancelar"
msgid "Создать"
msgstr "Criar"
msgid "Загружаю список версий…"
msgstr "Carregando lista de versões…"
msgid "Название"
msgstr "Nome"
msgid "Версия Minecraft, например 1.21.1 (можно ввести вручную)"
msgstr "Versão do Minecraft, por exemplo 1.21.1 (também pode ser digitada)"
msgid "Дополнительные действия"
msgstr "Mais ações"
msgid "Открыть папку"
msgstr "Abrir pasta"
msgid "Удалить"
msgstr "Excluir"
msgid "Сначала закройте запущенную игру"
msgstr "Feche o jogo em execução primeiro"
msgid "Экземпляр не найден или его путь некорректен"
msgstr "Instância não encontrada ou caminho inválido"
msgid "Не удалось полностью удалить файлы экземпляра"
msgstr "Não foi possível excluir todos os arquivos da instância"
msgid "Экземпляр удалён"
msgstr "Instância excluída"
msgid "Файлы экземпляра и ярлыки будут удалены без возможности восстановления."
msgstr "Os arquivos e atalhos da instância serão excluídos permanentemente."
msgid "Удалить экземпляр «%s»?"
msgstr "Excluir a instância “%s”?"
msgid "Ник должен содержать от 1 до 16 латинских букв, цифр или знаков _"
msgstr "O nome deve conter de 1 a 16 letras latinas, números ou sublinhados (_)"
msgid "Установка Minecraft"
msgstr "Instalando Minecraft"
msgid "Подготовка установки…"
msgstr "Preparando a instalação…"
msgid "Загрузка игрового клиента"
msgstr "Baixando o cliente do jogo"
msgid "Игровой клиент загружен"
msgstr "Cliente do jogo baixado"
msgid "Загрузка библиотек"
msgstr "Baixando bibliotecas"
msgid "Распаковка библиотек"
msgstr "Extraindo bibliotecas"
msgid "Загрузка игровых ресурсов"
msgstr "Baixando recursos do jogo"
msgid "Завершение установки"
msgstr "Finalizando a instalação"
msgid "Осталось"
msgstr "Restante"
msgid "Файлов: "
msgstr "Arquivos: "
msgid "файлов"
msgstr "arquivos"
