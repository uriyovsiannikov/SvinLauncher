msgid ""
msgstr ""
"Project-Id-Version: SvinLauncher 1.0\n"
"Language: en\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Не удалось сохранить язык интерфейса"
msgstr "Could not save the interface language"
msgid "Язык сохранён. Перезапустите SvinLauncher, чтобы применить его."
msgstr "Language saved. Restart SvinLauncher to apply it."
msgid "Настройки SvinLauncher"
msgstr "SvinLauncher Settings"
msgid "Закрыть"
msgstr "Close"
msgid "Сохранить"
msgstr "Save"
msgid "Минимальный лаунчер Minecraft Java Edition для GNOME. Создавайте экземпляры, выбирайте офлайн-имя и запускайте игру."
msgstr "A minimal Minecraft Java Edition launcher for GNOME. Create instances, choose an offline player name, and play."
msgid "Язык интерфейса"
msgstr "Interface language"
msgid "Язык системы"
msgstr "System language"
msgid "Создать экземпляр"
msgstr "Create instance"
msgid "Обновить список"
msgstr "Refresh list"
msgid "Настройки лаунчера"
msgstr "Launcher settings"
msgid "Нет экземпляров"
msgstr "No instances"
msgid "Создайте vanilla экземпляр, чтобы начать играть."
msgstr "Create a vanilla instance to start playing."
msgid "Имя игрока (оффлайн)"
msgstr "Player name (offline)"
msgid "Играть"
msgstr "Play"
msgid "Экземпляр с таким именем уже существует"
msgstr "An instance with this name already exists"
msgid "Minecraft установлен, экземпляр готов к офлайн-запуску"
msgstr "Minecraft is installed. The instance is ready to play offline."
msgid "Не удалось установить Minecraft"
msgstr "Could not install Minecraft"
msgid "Укажите название и версию вида 1.21.1"
msgstr "Enter a name and a version such as 1.21.1"
msgid "Не удалось загрузить список версий"
msgstr "Could not load the version list"
msgid "Новый экземпляр"
msgstr "New instance"
msgid "Создайте чистый экземпляр Minecraft Java Edition."
msgstr "Create a clean Minecraft Java Edition instance."
msgid "Отмена"
msgstr "Cancel"
msgid "Создать"
msgstr "Create"
msgid "Загружаю список версий…"
msgstr "Loading version list…"
msgid "Название"
msgstr "Name"
msgid "Версия Minecraft, например 1.21.1 (можно ввести вручную)"
msgstr "Minecraft version, for example 1.21.1 (you can enter it manually)"
msgid "Дополнительные действия"
msgstr "More actions"
msgid "Не удалось открыть папку экземпляра"
msgstr "Could not open the instance folder"
msgid "Не удалось удалить экземпляр: "
msgstr "Could not delete the instance: "
msgid "Экземпляр удалён, но не весь общий кэш удалось очистить: "
msgstr "Instance deleted, but some shared cache could not be cleared: "
msgid "Открыть папку"
msgstr "Open folder"
msgid "Удалить"
msgstr "Delete"
msgid "Сначала закройте запущенную игру"
msgstr "Close the running game first"
msgid "Экземпляр не найден или его путь некорректен"
msgstr "Instance not found or its path is invalid"
msgid "Не удалось полностью удалить файлы экземпляра"
msgstr "Could not remove all instance files"
msgid "Экземпляр удалён"
msgstr "Instance deleted"
msgid "Файлы экземпляра и ярлыки будут удалены без возможности восстановления."
msgstr "Instance files and shortcuts will be permanently deleted."
msgid "Удалить экземпляр «%s»?"
msgstr "Delete instance “%s”?"
msgid "Ник должен содержать от 1 до 16 латинских букв, цифр или знаков _"
msgstr "The player name must contain 1–16 Latin letters, digits, or underscores (_)"
msgid "Эта старая версия Minecraft несовместима с Java 9+. Нужна Java 8; укажите её путь в "
msgstr "This older Minecraft version is incompatible with Java 9+. Java 8 is required; set its path in "
msgid "Лог запуска: "
msgstr "Launch log: "
msgid "Запуск игры завершился с ошибкой"
msgstr "The game exited with an error"
msgid "Для этой версии ещё нет установленных файлов Minecraft. Сначала потребуется установить vanilla-файлы."
msgstr "Minecraft files for this version are missing. Install the vanilla files first."
msgid "В файле версии Minecraft отсутствует mainClass"
msgstr "The Minecraft version file has no mainClass"
msgid "Повреждён JSON-файл версии Minecraft"
msgstr "The Minecraft version JSON file is corrupted"
msgid "Не найден client.jar для Minecraft "
msgstr "Minecraft client.jar was not found for version "
msgid "Не удалось создать лог запуска: "
msgstr "Could not create the launch log: "
msgid "Не удалось запустить Java"
msgstr "Could not start Java"
msgid "Получение списка версий Minecraft"
msgstr "Fetching the Minecraft version list"
msgid "Не найдена release-версия Minecraft "
msgstr "Minecraft release version not found: "
msgid "Получение данных Minecraft "
msgstr "Fetching Minecraft metadata for "
msgid "Манифест содержит небезопасный путь библиотеки"
msgstr "The manifest contains an unsafe library path"
msgid "Загрузка списка игровых ресурсов"
msgstr "Downloading the game asset index"
msgid "Манифест ассетов содержит некорректный SHA-1"
msgstr "The asset manifest contains an invalid SHA-1 hash"
msgid "Не удалось подготовить виртуальные ресурсы Minecraft: "
msgstr "Could not prepare virtual Minecraft assets: "
msgid "Не удалось сохранить файлы экземпляра"
msgstr "Could not save the instance files"
msgid "Не удалось подключиться к серверу версий Minecraft"
msgstr "Could not connect to the Minecraft version server"
msgid "Не удалось отправить запрос списка версий"
msgstr "Could not request the version list"
msgid "Ошибка чтения списка версий"
msgstr "Error reading the version list"
msgid "Ответ со списком версий слишком большой"
msgstr "The version list response is too large"
msgid "Сервер версий Minecraft вернул некорректный ответ"
msgstr "The Minecraft version server returned an invalid response"
msgid "Не удалось прочитать ответ сервера версий Minecraft"
msgstr "Could not read the Minecraft version server response"
msgid "Не удалось разобрать список версий Minecraft"
msgstr "Could not parse the Minecraft version list"
msgid "ч"
msgstr "h"
msgid "мин"
msgstr "min"
msgid "с"
msgstr "s"
msgid "Установка Minecraft"
msgstr "Installing Minecraft"
msgid "Подготовка установки…"
msgstr "Preparing installation…"
msgid "Загрузка игрового клиента"
msgstr "Downloading game client"
msgid "Игровой клиент загружен"
msgstr "Game client downloaded"
msgid "Загрузка библиотек"
msgstr "Downloading libraries"
msgid "Распаковка библиотек"
msgstr "Extracting libraries"
msgid "Загрузка игровых ресурсов"
msgstr "Downloading game assets"
msgid "Завершение установки"
msgstr "Finishing installation"
msgid "Осталось"
msgstr "Remaining"
msgid "Файлов: "
msgstr "Files: "
msgid "файлов"
msgstr "files"
msgid "Недопустимый URL загрузки Minecraft"
msgstr "Invalid Minecraft download URL"
msgid "Недопустимый сервер загрузки Minecraft"
msgstr "Invalid Minecraft download server"
msgid "Не удалось подключиться к серверу Minecraft"
msgstr "Could not connect to the Minecraft server"
msgid "Не удалось отправить запрос серверу Minecraft"
msgstr "Could not send a request to the Minecraft server"
msgid "Ошибка загрузки файлов Minecraft"
msgstr "Error downloading Minecraft files"
msgid "Ответ сервера Minecraft слишком большой"
msgstr "The Minecraft server response is too large"
msgid "Обрезан ответ Minecraft"
msgstr "The Minecraft response was truncated"
msgid "Некорректный ответ сервера Minecraft"
msgstr "Invalid response from the Minecraft server"
msgid "Сервер Minecraft прислал redirect без адреса"
msgstr "The Minecraft server sent a redirect without a location"
msgid "Сервер Minecraft прислал небезопасный адрес"
msgstr "The Minecraft server sent an insecure URL"
msgid "Ошибка загрузки"
msgstr "Download error"
msgid "Повреждён chunked-ответ Minecraft"
msgstr "The chunked Minecraft response is corrupted"
msgid "Не удалось разобрать манифест Minecraft"
msgstr "Could not parse the Minecraft manifest"
msgid "Не удалось создать каталог: "
msgstr "Could not create directory: "
msgid "Не удалось записать файл "
msgstr "Could not write file "
msgid "Проверка SHA-1 не прошла для "
msgstr "SHA-1 verification failed for "
msgid "Не удалось открыть native-библиотеку "
msgstr "Could not open native library "
msgid "Повреждён native ZIP-файл"
msgstr "The native ZIP file is corrupted"
msgid "Повреждён каталог native ZIP-файла"
msgstr "The native ZIP directory is corrupted"
msgid "Обрезан native ZIP-файл"
msgstr "The native ZIP file is truncated"
msgid "Некорректный размер native-файла"
msgstr "Invalid native file size"
msgid "Не удалось распаковать native-библиотеки"
msgstr "Could not extract native libraries"
msgid "Native ZIP-файл повреждён"
msgstr "The native ZIP file is corrupted"
msgid "Проверка native-файла не прошла"
msgstr "Native file verification failed"
msgid "Не удалось распаковать native-файлы"
msgstr "Could not extract native files"
