msgid ""
msgstr ""
"Project-Id-Version: SvinLauncher 1.0\n"
"Language: pl\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Не удалось сохранить язык интерфейса"
msgstr "Nie udało się zapisać języka interfejsu"
msgid "Язык сохранён. Перезапустите SvinLauncher, чтобы применить его."
msgstr "Język zapisano. Uruchom SvinLauncher ponownie, aby go zastosować."
msgid "Настройки SvinLauncher"
msgstr "Ustawienia SvinLauncher"
msgid "Закрыть"
msgstr "Zamknij"
msgid "Сохранить"
msgstr "Zapisz"
msgid "Минимальный лаунчер Minecraft Java Edition для GNOME. Создавайте экземпляры, выбирайте офлайн-имя и запускайте игру."
msgstr "Prosty launcher Minecraft Java Edition dla GNOME. Twórz instancje, wybieraj nazwę offline i graj."
msgid "Язык интерфейса"
msgstr "Język interfejsu"
msgid "Язык системы"
msgstr "Język systemu"
msgid "Создать экземпляр"
msgstr "Utwórz instancję"
msgid "Обновить список"
msgstr "Odśwież listę"
msgid "Настройки лаунчера"
msgstr "Ustawienia launchera"
msgid "Нет экземпляров"
msgstr "Brak instancji"
msgid "Создайте vanilla экземпляр, чтобы начать играть."
msgstr "Utwórz instancję vanilla, aby rozpocząć grę."
msgid "Имя игрока (оффлайн)"
msgstr "Nazwa gracza (offline)"
msgid "Играть"
msgstr "Graj"
msgid "Экземпляр с таким именем уже существует"
msgstr "Instancja o tej nazwie już istnieje"
msgid "Minecraft установлен, экземпляр готов к офлайн-запуску"
msgstr "Minecraft jest zainstalowany. Instancja jest gotowa do gry offline."
msgid "Не удалось установить Minecraft"
msgstr "Nie udało się zainstalować Minecrafta"
msgid "Укажите название и версию вида 1.21.1"
msgstr "Podaj nazwę i wersję, np. 1.21.1"
msgid "Не удалось загрузить список версий"
msgstr "Nie udało się wczytać listy wersji"
msgid "Новый экземпляр"
msgstr "Nowa instancja"
msgid "Создайте чистый экземпляр Minecraft Java Edition."
msgstr "Utwórz czystą instancję Minecraft Java Edition."
msgid "Отмена"
msgstr "Anuluj"
msgid "Создать"
msgstr "Utwórz"
msgid "Загружаю список версий…"
msgstr "Wczytywanie listy wersji…"
msgid "Название"
msgstr "Nazwa"
msgid "Версия Minecraft, например 1.21.1 (можно ввести вручную)"
msgstr "Wersja Minecrafta, np. 1.21.1 (możesz wpisać ją ręcznie)"
msgid "Дополнительные действия"
msgstr "Więcej działań"
msgid "Открыть папку"
msgstr "Otwórz folder"
msgid "Удалить"
msgstr "Usuń"
msgid "Сначала закройте запущенную игру"
msgstr "Najpierw zamknij uruchomioną grę"
msgid "Экземпляр не найден или его путь некорректен"
msgstr "Nie znaleziono instancji lub jej ścieżka jest nieprawidłowa"
msgid "Не удалось полностью удалить файлы экземпляра"
msgstr "Nie udało się usunąć wszystkich plików instancji"
msgid "Экземпляр удалён"
msgstr "Instancja została usunięta"
msgid "Файлы экземпляра и ярлыки будут удалены без возможности восстановления."
msgstr "Pliki instancji i skróty zostaną trwale usunięte."
msgid "Удалить экземпляр «%s»?"
msgstr "Usunąć instancję „%s”?"
msgid "Ник должен содержать от 1 до 16 латинских букв, цифр или знаков _"
msgstr "Nazwa gracza musi zawierać 1–16 łacińskich liter, cyfr lub podkreśleń (_)"
msgid "Установка Minecraft"
msgstr "Instalowanie Minecrafta"
msgid "Подготовка установки…"
msgstr "Przygotowywanie instalacji…"
msgid "Загрузка игрового клиента"
msgstr "Pobieranie klienta gry"
msgid "Игровой клиент загружен"
msgstr "Klient gry został pobrany"
msgid "Загрузка библиотек"
msgstr "Pobieranie bibliotek"
msgid "Распаковка библиотек"
msgstr "Rozpakowywanie bibliotek"
msgid "Загрузка игровых ресурсов"
msgstr "Pobieranie zasobów gry"
msgid "Завершение установки"
msgstr "Kończenie instalacji"
msgid "Осталось"
msgstr "Pozostało"
msgid "Файлов: "
msgstr "Plików: "
msgid "файлов"
msgstr "plików"
