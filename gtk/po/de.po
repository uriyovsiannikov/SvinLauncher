msgid ""
msgstr ""
"Project-Id-Version: SvinLauncher 1.0\n"
"Language: de\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Не удалось сохранить язык интерфейса"
msgstr "Die Oberflächensprache konnte nicht gespeichert werden"
msgid "Язык сохранён. Перезапустите SvinLauncher, чтобы применить его."
msgstr "Sprache gespeichert. Starte SvinLauncher neu, um sie anzuwenden."
msgid "Настройки SvinLauncher"
msgstr "SvinLauncher-Einstellungen"
msgid "Закрыть"
msgstr "Schließen"
msgid "Сохранить"
msgstr "Speichern"
msgid "Минимальный лаунчер Minecraft Java Edition для GNOME. Создавайте экземпляры, выбирайте офлайн-имя и запускайте игру."
msgstr "Ein schlanker Minecraft-Java-Launcher für GNOME. Erstelle Instanzen, wähle einen Offline-Spielernamen und spiele los."
msgid "Язык интерфейса"
msgstr "Oberflächensprache"
msgid "Язык системы"
msgstr "Systemsprache"
msgid "Создать экземпляр"
msgstr "Instanz erstellen"
msgid "Обновить список"
msgstr "Liste aktualisieren"
msgid "Настройки лаунчера"
msgstr "Launcher-Einstellungen"
msgid "Нет экземпляров"
msgstr "Keine Instanzen"
msgid "Создайте vanilla экземпляр, чтобы начать играть."
msgstr "Erstelle eine Vanilla-Instanz, um loszuspielen."
msgid "Имя игрока (оффлайн)"
msgstr "Spielername (offline)"
msgid "Играть"
msgstr "Spielen"
msgid "Экземпляр с таким именем уже существует"
msgstr "Eine Instanz mit diesem Namen existiert bereits"
msgid "Minecraft установлен, экземпляр готов к офлайн-запуску"
msgstr "Minecraft ist installiert. Die Instanz ist offline spielbereit."
msgid "Не удалось установить Minecraft"
msgstr "Minecraft konnte nicht installiert werden"
msgid "Укажите название и версию вида 1.21.1"
msgstr "Gib einen Namen und eine Version wie 1.21.1 ein"
msgid "Не удалось загрузить список версий"
msgstr "Die Versionsliste konnte nicht geladen werden"
msgid "Новый экземпляр"
msgstr "Neue Instanz"
msgid "Создайте чистый экземпляр Minecraft Java Edition."
msgstr "Erstelle eine unveränderte Minecraft-Java-Edition-Instanz."
msgid "Отмена"
msgstr "Abbrechen"
msgid "Создать"
msgstr "Erstellen"
msgid "Загружаю список версий…"
msgstr "Versionsliste wird geladen …"
msgid "Название"
msgstr "Name"
msgid "Версия Minecraft, например 1.21.1 (можно ввести вручную)"
msgstr "Minecraft-Version, zum Beispiel 1.21.1 (manuelle Eingabe möglich)"
msgid "Дополнительные действия"
msgstr "Weitere Aktionen"
msgid "Открыть папку"
msgstr "Ordner öffnen"
msgid "Удалить"
msgstr "Löschen"
msgid "Сначала закройте запущенную игру"
msgstr "Schließe zuerst das laufende Spiel"
msgid "Экземпляр не найден или его путь некорректен"
msgstr "Instanz nicht gefunden oder ungültiger Pfad"
msgid "Не удалось полностью удалить файлы экземпляра"
msgstr "Die Instanzdateien konnten nicht vollständig gelöscht werden"
msgid "Экземпляр удалён"
msgstr "Instanz gelöscht"
msgid "Файлы экземпляра и ярлыки будут удалены без возможности восстановления."
msgstr "Instanzdateien und Verknüpfungen werden dauerhaft gelöscht."
msgid "Удалить экземпляр «%s»?"
msgstr "Instanz „%s“ löschen?"
msgid "Ник должен содержать от 1 до 16 латинских букв, цифр или знаков _"
msgstr "Der Spielername muss 1–16 lateinische Buchstaben, Ziffern oder Unterstriche (_) enthalten"
msgid "Установка Minecraft"
msgstr "Minecraft wird installiert"
msgid "Подготовка установки…"
msgstr "Installation wird vorbereitet …"
msgid "Загрузка игрового клиента"
msgstr "Spielclient wird heruntergeladen"
msgid "Игровой клиент загружен"
msgstr "Spielclient heruntergeladen"
msgid "Загрузка библиотек"
msgstr "Bibliotheken werden heruntergeladen"
msgid "Распаковка библиотек"
msgstr "Bibliotheken werden entpackt"
msgid "Загрузка игровых ресурсов"
msgstr "Spielressourcen werden heruntergeladen"
msgid "Завершение установки"
msgstr "Installation wird abgeschlossen"
msgid "Осталось"
msgstr "Verbleibend"
msgid "Файлов: "
msgstr "Dateien: "
msgid "файлов"
msgstr "Dateien"
